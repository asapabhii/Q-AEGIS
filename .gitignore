# Secrets. Never commit these. See AGENTS.md security rules.
.env
.env.*
!.env.example

# Claude Code local settings — holds ANTHROPIC_AUTH_TOKEN. NEVER commit.
.claude/

# Codex CLI local config — another tool's local settings, not project source.
.codex/

# Runtime config holding a live secret_key + local logs/cache. NEVER commit.
config/

# Scratch test logs from local pytest runs.
backend/backend_test.txt
backend/backend_fullrun.txt
backend/backend_pr2_*.txt

# Classifier training corpora: large (100s of MB), regenerable from the prep
# scripts, and/or licensed (FOIArchive is non-commercial). NEVER commit the
# corpus — only the trained artifact + its evaluation report ship.
backend/data/

# Superseded classifier artifacts — only the current shipping version is
# tracked. These earlier experiments (25k in-memory subsample; plain-TF SGD)
# are kept locally for comparison but must not enter git history.
backend/artifacts/classifier/wikileaks-cables-hashing-sgd-1.0.0.*
backend/artifacts/classifier/wikileaks-cables-tfidf-svc-1.0.0.*
backend/artifacts/classifier/foiarchive*

# Python
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/

# Node / frontend
node_modules/
.next/
out/
npm-debug.log*
yarn-error.log*

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local infra state
infra/data/
# Local TLS material (scripts/generate-local-certs.*). Never commit keys.
infra/certs/
# Machine-local compose override: wires the corporate TLS-inspection CA
# (infra/certs/sophos-inspection-ca.crt) into the backend for the agent LLM
# endpoint. Environment-specific + references a gitignored CA, so it stays local.
infra/docker-compose.override.yml

# OPA CLI and extract leftovers from compiling the policy WASM bundle.
# Commit policy.rego, policy.wasm, and capabilities.json only.
backend/app/policy/rego/opa.exe
backend/opa.exe
*.exe
backend/app/policy/rego/bundle.tar.gz
backend/app/policy/rego/data.json
backend/app/policy/rego/.manifest
frontend/test_output.txt
frontend/coverage/
_agent_plans/

# CLAUDE.md is the local-only deep engineering companion (real-vs-stub state,
# current PR status, host/Docker gotchas, execution plan). It is intentionally
# NOT committed — the committed, cross-agent standing rules live in AGENTS.md.
# frontend/CLAUDE.md + frontend/AGENTS.md are regenerated by `next dev`; keep local.
/CLAUDE.md
frontend/CLAUDE.md
frontend/AGENTS.md
