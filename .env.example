# Q-AEGIS Shield, example environment file.
# Dummy values only. Copy to .env and fill in real values locally.
# .env is gitignored and must never be committed (AGENTS.md security rules).
#
# Key management this phase is environment-configured secrets, not an HSM.
# See PRD.md Non-Goal NG5 and SPEC.md Section 6 "Key management this phase".
#
# WHY EVERY HOST BELOW IS 127.0.0.1 AND NOT localhost:
# infra/docker-compose.yml publishes every port to 127.0.0.1 only, so nothing is
# reachable from the local network. On Windows and on some Linux setups,
# "localhost" resolves to the IPv6 address ::1 first, and a client that tries
# ::1 against an IPv4-only listener does not fail fast, it hangs until the
# connection times out. The symptom is a `docker compose ps` showing every
# service healthy while the application appears to freeze on its first query.
# Pinning the literal IPv4 address removes the resolution step entirely.
# Do not "tidy" these back to localhost.

# --- Postgres ---
POSTGRES_HOST=127.0.0.1
# Port Postgres listens on INSIDE the container. Do not change: infra/docker-
# compose.yml maps host 15432 -> container 5432, and this is the container side.
POSTGRES_PORT=5432
POSTGRES_DB=qaegis
POSTGRES_USER=qaegis
POSTGRES_PASSWORD=SET_LOCALLY
# Driver is psycopg (version 3), not psycopg2. Keep the +psycopg suffix: without
# it SQLAlchemy defaults to psycopg2, which is not installed.
#
# PORT 15432, NOT 5432: infra/docker-compose.yml publishes Postgres on
# 127.0.0.1:15432 (host) -> 5432 (container) to avoid colliding with a local
# Postgres install. Processes on the HOST (uvicorn, alembic) must connect to
# 15432; only in-network containers use 5432 (the compose backend service sets
# its own DATABASE_URL to postgres:5432). See docs/LOCAL_DEV.md.
DATABASE_URL=postgresql+psycopg://qaegis:SET_LOCALLY@127.0.0.1:15432/qaegis

# --- Redis (event bus, SPEC.md 3.1, Redis Streams per 2.3) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=SET_LOCALLY
REDIS_URL=redis://:SET_LOCALLY@127.0.0.1:6379/0
# Optional: when Redis is TLS (PR #27 compose uses rediss://), set:
# REDIS_URL=rediss://:SET_LOCALLY@127.0.0.1:6379/0
# REDIS_SSL_CA_CERTS=../infra/certs/ca.crt

# --- Neo4j (knowledge graph, SPEC.md 3.11) ---
#
# WARNING, read before adding any variable here whose name starts with NEO4J_:
# the official neo4j image treats that prefix as its server-configuration
# namespace and maps each such variable to a config setting, then strict-
# validates the result. Because infra/docker-compose.yml passes this whole file
# to the container via env_file, a well-meaning NEO4J_URI here becomes a config
# setting named "URI", which Neo4j does not recognize, and the container then
# crash-loops with "Failed to read config: Unrecognized setting".
#
# So: application-side Neo4j settings are deliberately QAEGIS_-prefixed, and
# the only NEO4J_-prefixed names used are ones the image genuinely defines
# (NEO4J_AUTH, and the NEO4J_server_* tuning keys set in the compose file).
# Bolt TLS required in local compose (tls_level=REQUIRED). Prefer bolt+s://
# with QAEGIS_NEO4J_SSL_CA_CERTS (path relative to backend/ when running
# uvicorn there). The driver rewrites bolt+s → bolt + TrustCustomCAs because
# neo4j-python forbids trusted_certificates on +s URIs.
QAEGIS_NEO4J_URI=bolt+s://127.0.0.1:7687
QAEGIS_NEO4J_USER=neo4j
QAEGIS_NEO4J_PASSWORD=SET_LOCALLY
QAEGIS_NEO4J_SSL_CA_CERTS=../infra/certs/ca.crt

# Recognized by the image's entrypoint (not as a config setting) to set the
# initial password. Keep the password half in sync with QAEGIS_NEO4J_PASSWORD.
NEO4J_AUTH=neo4j/SET_LOCALLY

# --- RAG embeddings (SPEC.md 3.12 / FR-11) ---
# Backend: "fastembed" (real transformer embeddings via ONNX, production default)
# or "deterministic" (hash-based, non-semantic; tests / air-gapped smoke only).
RAG_EMBEDDING_BACKEND=fastembed
# fastembed model id. Its native dimension MUST equal RAG_EMBEDDING_DIMS and the
# rag_chunks.embedding vector(N) column. BAAI/bge-large-en-v1.5 = 1024.
RAG_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RAG_EMBEDDING_DIMS=1024
# Minimum cosine similarity a retrieved chunk must clear to ground an answer
# (the "refuse if ungrounded" gate). Only active for the fastembed backend; the
# deterministic backend disables it (non-semantic). Raise to refuse more often.
RAG_MIN_SIMILARITY=0.30

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
# Browser origins allowed to call the API (comma-separated). Include HTTPS local UI.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://127.0.0.1:3443,https://localhost:3443
# FR-2: seconds between scheduled risk recomputes. 0 disables the ticker.
RISK_RECOMPUTE_INTERVAL_SECONDS=300

# --- Auth (local JWT; X-Q-AEGIS-Actor-Role is DEV-ONLY when bypass is true) ---
JWT_SECRET=SET_LOCALLY
JWT_EXPIRE_MINUTES=480
# Opt-in local only. Default in Settings is false — must set true here for header bypass.
AUTH_DEV_HEADER_BYPASS=true
# Password for `python -m app.db.seed` (not hard-coded in the repo). Local/dev only.
QAEGIS_DEV_SEED_PASSWORD=SET_LOCALLY
# CA PEM for rediss:// / verify-ca (compose uses /certs/ca.crt inside containers).
REDIS_SSL_CA_CERTS=C:/Q-AEGIS/infra/certs/ca.crt

# --- Document upload (local disk, not object storage this phase) ---
DOCUMENT_STORAGE_DIR=data/documents
UPLOAD_MAX_BYTES=52428800

# Host-side DATABASE_URL / REDIS_URL for uvicorn on the laptop (after generating
# infra/certs/). Postgres is published on host port 15432 (not 5432).
# sslmode=verify-ca + rediss:// need the local CA trusted by the process or
# SSL_CERT_FILE pointed at infra/certs/ca.crt.
# DATABASE_URL=postgresql+psycopg://qaegis:SET_LOCALLY@127.0.0.1:15432/qaegis?sslmode=verify-ca&sslrootcert=C:/Q-AEGIS/infra/certs/ca.crt
# REDIS_URL=rediss://:SET_LOCALLY@127.0.0.1:6379/0

# Compose backend publishes https://127.0.0.1:8443 — set the frontend to:
# NEXT_PUBLIC_API_URL=https://127.0.0.1:8443

# --- Classifier (SPEC.md 3.2 / FR-1) ---
# Confidence below this threshold defaults to the MORE sensitive label
# (fail-safe escalation: an uncertain or out-of-distribution document resolves
# UPWARD toward more protection, never silently PUBLIC).
CLASSIFIER_CONFIDENCE_THRESHOLD=0.60
# Path to a trained classifier artifact (app/classifier/training.py output).
# When set and present, the trained model runs and the high-precision keyword
# rules + content detectors become an escalation-only override (they can only
# raise the label, never lower it); unset/missing falls back to the labelled
# keyword engine. The Docker image BAKES the shipping bundle and sets this to
# /srv/artifacts/classifier/multigenre-hashing-svm-1.0.0.joblib (see backend/
# Dockerfile + infra/docker-compose.yml, whose environment: block pins the
# in-container path so an empty value here cannot mask the baked model). Leave
# blank when running inside the image. To run the trained model on the HOST
# (uvicorn/pytest/scripts started from backend/), point this at the artifact,
# e.g. C:/Q-AEGIS/backend/artifacts/classifier/multigenre-hashing-svm-1.0.0.joblib
CLASSIFIER_MODEL_PATH=

# --- Agents (SPEC.md 3.4 / FR-3) ---
# Backend: "anthropic" (real Claude scoring; each agent's model + rationale is
# recorded in the Merkle audit) or "deterministic" (reviewable heuristic scorers).
# Leave deterministic until credentials are set, then switch to anthropic.
AGENT_LLM_BACKEND=deterministic
AGENT_LLM_MODEL=claude-opus-4-8
# The backend's OWN Anthropic key (separate from any local tooling). Required
# only when AGENT_LLM_BACKEND=anthropic. Never commit a real key.
AGENT_LLM_API_KEY=
# Optional Anthropic-compatible gateway/proxy base URL.
AGENT_LLM_BASE_URL=
AGENT_LLM_MAX_TOKENS=512
AGENT_LLM_TIMEOUT_SECONDS=20

# --- Crypto engine (SPEC.md 3.7) ---
# Base64url-encoded 32-byte master key for wrapping DEKs. Environment-configured,
# not an HSM (PRD.md NG5). Dummy value only; generate a real key locally.
# Generate: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
CRYPTO_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
